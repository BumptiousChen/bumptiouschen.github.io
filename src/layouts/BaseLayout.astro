---
interface Props { title: string; description?: string; home?: boolean }
const { title, description = '记录技术、开发与生活。', home = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Solaris Blog</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="stylesheet" href={`${base}/style.css`} />
    {home && <script is:inline>
      try {
        if (!sessionStorage.getItem('solaris-p3r-intro-seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro-prep');
          // Reveal the homepage if the processed script cannot load.
          window.setTimeout(() => {
            if (!document.documentElement.classList.contains('hero-enhanced')) document.documentElement.classList.remove('intro-prep');
          }, 10000);
        }
      } catch (_) { /* The finished homepage remains visible when storage is unavailable. */ }
    </script>}
  </head>
  <body class:list={{ 'home-page': home }}>
    <header class:list={['site-header', { 'site-header--home': home }]}>
      <div class="container header-inner">
        <a class="brand" href={`${base}/`}>Solaris<span>.</span></a>
        <nav class="desktop-nav" aria-label="主导航">
          <a href={`${base}/`}>首页</a>
          <a href={`${base}/posts/`}>文章</a>
          <a href={`${base}/about/`}>关于</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="打开导航菜单"><span></span><span></span><span></span></summary>
          <nav aria-label="移动端主导航">
            <a href={`${base}/`}>首页</a>
            <a href={`${base}/posts/`}>文章</a>
            <a href={`${base}/about/`}>关于</a>
          </nav>
        </details>
      </div>
    </header>
    <main class:list={{ container: !home }}><slot /></main>
    <footer class="site-footer container">© {new Date().getFullYear()} Solaris · 记录与分享</footer>
  </body>
</html>
