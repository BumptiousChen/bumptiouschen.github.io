---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="首页">
  <section class="hero">
    <p class="eyebrow">PERSONAL BLOG</p>
    <h1>你好，这里是 Solaris。</h1>
    <p>记录技术、开发与生活，把学到的东西慢慢写下来。</p>
    <a class="primary-link" href={`${base}/posts/`}>阅读文章 →</a>
  </section>
  <section aria-labelledby="latest-heading">
    <div class="section-heading">
      <h2 id="latest-heading">最新文章</h2>
      <a href={`${base}/posts/`}>查看全部 →</a>
    </div>
    <div class="post-list">
      {posts.slice(0, 5).map((post) => (
        <article class="post-card">
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
          <h3><a href={`${base}/posts/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
