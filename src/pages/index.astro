---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import LatestArticles from '../components/LatestArticles.astro';
import { home } from '../config/home';
import { getPublicPosts } from '../lib/posts';
import { selectHomepagePosts } from '../lib/post-utils';
const posts = selectHomepagePosts(await getPublicPosts(), home.latest.featuredIds, home.latest.limit);
---
<BaseLayout title="首页"><HomeHero /><LatestArticles posts={posts} /></BaseLayout>
