---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OceanMedia from '../components/OceanMedia.astro';
import IntroCurtain from '../components/IntroCurtain.astro';
import '../styles/p3r-home.css';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="首页" home>
  <section class="ocean-hero" data-ocean-intro aria-label="Solaris 首页">
    <div class="ocean-scene"><OceanMedia /></div>

    <IntroCurtain />
    <p class="hero-manifesto">A LITTLE CURIOSITY.<br />A WORLD TO DISCOVER.</p>
    <div class="hero-copy">
      <p class="hero-kicker">PERSONAL LOG <span>／</span> 001</p>
      <h1 aria-label="在蓝色之间，记录世界。">
        <span class="hero-title-line" aria-hidden="true">{Array.from('在蓝色之间，').map((letter, index) => <span class="hero-letter" style={`--letter-index: ${index}`}>{letter}</span>)}</span>
        <em class="hero-title-line" aria-hidden="true">{Array.from('记录世界。').map((letter, index) => <span class="hero-letter" style={`--letter-index: ${index + 6}`}>{letter}</span>)}</em>
      </h1>
      <p class="hero-description">技术、开发，还有沿途的生活。</p>
      <a class="hero-link" href={`${base}/posts/`}>阅读文章 <span aria-hidden="true">↗</span></a>
    </div>

    <div class="hero-bottom">
      <div class="hero-colophon"><span>SOLARIS <span class="hero-bottom-separator">—</span> A PERSONAL BLOG</span><small>VISUAL / PERSONA 3 RELOAD · © ATLUS © SEGA</small></div>
      <a href="#latest-heading" class="scroll-cue">向下探索 <span aria-hidden="true">↓</span></a>
    </div>

    <button class="intro-skip" type="button" data-skip-intro>跳过动画 <span aria-hidden="true">→</span></button>
    <button class="intro-replay" type="button" data-replay-intro aria-label="重播开场动画">重播开场 ↻</button>
    <button class="background-toggle" type="button" data-toggle-background aria-label="暂停背景视频">暂停背景 Ⅱ</button>
  </section>

  <section class="latest-section" aria-labelledby="latest-heading">
    <div class="latest-inner">
      <div class="latest-heading-row">
        <div>
          <p class="latest-kicker">FIELD NOTES / 记录</p>
          <h2 id="latest-heading">最新文章<span>.</span></h2>
        </div>
        <a href={`${base}/posts/`}>查看全部文章 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="post-list latest-posts">
        {posts.slice(0, 5).map((post, index) => (
          <article class="post-card">
            <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
              <h3><a href={`${base}/posts/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <span class="post-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </div>
  </section>
  <script src="../scripts/hero-media.ts"></script>
</BaseLayout>
