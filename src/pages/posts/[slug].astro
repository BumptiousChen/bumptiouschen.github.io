---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicPosts } from '../../lib/posts';
import { calendarDate, formatDate } from '../../lib/post-utils';
import { pathFor } from '../../lib/paths';
import { categories } from '../../config/site';
export async function getStaticPaths() {
  return (await getPublicPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <a class="back-link" href={pathFor('posts/')}>← 所有文章</a>
    <header class="article-header">
      <a class="eyebrow" href={pathFor(`categories/${post.data.category}/`)}>{categories[post.data.category].label}</a>
      <time datetime={calendarDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
      <h1>{post.data.title}</h1><p>{post.data.description}</p>
    </header>
    {post.data.sample && <aside class="sample-notice">这是一篇用于首页排版预览的示例文章。</aside>}
    {post.data.cover && <Image class="article-cover" src={post.data.cover} alt={post.data.coverAlt ?? ''} width={1440} widths={[480, 960, 1440]} sizes="(max-width: 768px) 100vw, 720px" />}
    <div class="prose"><Content /></div>
    <a class="back-link article-back" href={pathFor('posts/')}>← 回到文章列表</a>
  </article>
</BaseLayout>
