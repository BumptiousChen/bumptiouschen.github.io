---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import ArticlePreview from '../../components/ArticlePreview.astro';
import { getPublicPosts } from '../../lib/posts';
const posts = await getPublicPosts();
---
<BaseLayout title="文章">
  <section class="page-intro"><p class="eyebrow">WRITINGS</p><h1>所有文章</h1><p>游戏、动画，以及那些值得记下的普通日子。</p></section>
  <CategoryNav />
  <div class="archive-list">{posts.map((post, index) => <ArticlePreview post={post} index={index} headingLevel="h2" />)}</div>
  {!posts.length && <p class="empty-state">第一篇记录，还在路上。</p>}
</BaseLayout>
